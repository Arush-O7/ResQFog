# SMS alerts, sent from an ordinary SIM card so the text can include the
# pump details and location (no app needed on the receiving phone).
# Numbers to alert, with country code; several numbers separated by commas.
SMS_TO=+91XXXXXXXXXX

# Option 1 (default): an Android phone with the free "SMS Gateway for Android"
# app (sms-gate.app) in Local Server mode, on the same Wi-Fi as this computer.
# Copy the address, username and password shown in the app.
SMS_BACKEND=android
SMS_GATEWAY_URL=http://192.168.1.20:8080
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# Option 2: a SIM800L / A7670 GSM module on a USB-serial adapter.
# SMS_BACKEND=gsm
# GSM_PORT=/dev/tty.usbserial-0001      (Windows: COM3)
# GSM_BAUD=9600
