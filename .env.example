# SMS alerts (the receiving phone needs no app).
# Numbers to alert, with country code; several numbers separated by commas.
SMS_TO=+91XXXXXXXXXX

# Option 1 (default): an Android phone with a SIM running the free, open-source
# SMSGate app (https://sms-gate.app). Install the APK, turn on Local Server, keep
# the phone on the same Wi-Fi as this computer, and copy the address, username
# and password shown in the app. Sends the full alert with a Google Maps link.
SMS_BACKEND=android
SMS_GATEWAY_URL=http://192.168.1.20:8080
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# Option 2: an A7670C (4G) or SIM800L (2G only, needs an Airtel/Vi SIM) GSM
# module on a USB-serial adapter. Sends the full alert text. Needs pyserial.
# SMS_BACKEND=gsm
# GSM_PORT=/dev/tty.usbserial-0001      (Windows: COM3)
# GSM_BAUD=9600

# Option 3: CircuitDigest Cloud free SMS API (India only, 100 SMS a month,
# fixed templates with two short fields, numbers verified by OTP).
# SMS_BACKEND=circuitdigest
# CIRCUITDIGEST_API_KEY=

# Optional: seconds between alerts of the same type for one pump
# (default 60, or 600 for CircuitDigest)
# ALERT_COOLDOWN=60

# Escalation: an alert nobody acknowledges on the dashboard within
# ESCALATE_AFTER seconds is sent to these numbers (for example the supervisor).
# If SMS_ESCALATE_TO is empty it goes to SMS_TO again.
# SMS_ESCALATE_TO=+91XXXXXXXXXX
# ESCALATE_AFTER=600

# Running hours between services (greasing, inspection); default 2000
# SERVICE_EVERY_HOURS=2000

# Seconds per stored health point (default 60)
# HEALTH_INTERVAL=60
