# SMS alerts (the receiving phone needs no app).
# Numbers to alert, with country code; several numbers separated by commas.
SMS_TO=+91XXXXXXXXXX

# Option 1 (default): CircuitDigest Cloud free SMS API (India only).
# Sign up at circuitdigest.cloud, verify each receiving number with the OTP
# (up to 5), and copy the API key from Account > API Key.
# Free plan: 100 SMS a month, fixed templates with two short fields, so
# alerts are limited to one per pump and type every 10 minutes.
SMS_BACKEND=circuitdigest
CIRCUITDIGEST_API_KEY=

# Option 2: an Android phone with the free "SMS Gateway for Android" app
# (sms-gate.app) in Local Server mode, on the same Wi-Fi. Sends the full
# alert text with a map link.
# SMS_BACKEND=android
# SMS_GATEWAY_URL=http://192.168.1.20:8080
# SMS_GATEWAY_USER=
# SMS_GATEWAY_PASSWORD=

# Option 3: a SIM800L / A7670 GSM module on a USB-serial adapter (full text).
# SMS_BACKEND=gsm
# GSM_PORT=/dev/tty.usbserial-0001      (Windows: COM3)
# GSM_BAUD=9600

# Optional: seconds between alerts of the same type for one pump
# (default 600 for CircuitDigest, 60 otherwise)
# ALERT_COOLDOWN=600
