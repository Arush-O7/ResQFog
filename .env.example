# Telegram alerts (free). Leave empty to run without alerts.
# 1. In Telegram, talk to @BotFather, send /newbot and copy the token here.
# 2. Send any message to your new bot (or add it to a group and post there).
# 3. Run: python3 fog_server.py --find-chat-id   and copy the number here.
#    Several chats or groups can be listed, separated by commas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
