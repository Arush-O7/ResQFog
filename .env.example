# SMS alerts through the free CircuitDigest Cloud SMS API (India only).
# 1. Sign up at https://www.circuitdigest.cloud and verify each receiving
#    number with the OTP (up to 5 numbers).
# 2. Copy the API key from your account into CIRCUITDIGEST_API_KEY.
# The free plan allows 100 SMS a month; each alert uses one SMS per number,
# two when the pump has a location (issue + location).
CIRCUITDIGEST_API_KEY=

# Numbers to alert, with country code; several numbers separated by commas.
SMS_TO=+91XXXXXXXXXX

# Escalation: an alert nobody acknowledges on the dashboard within
# ESCALATE_AFTER seconds is sent to these numbers (for example the supervisor).
# If SMS_ESCALATE_TO is empty it goes to SMS_TO again.
# SMS_ESCALATE_TO=+91XXXXXXXXXX
# ESCALATE_AFTER=600

# Seconds between alerts of the same type for one pump (default 600)
# ALERT_COOLDOWN=600

# Running hours between services (greasing, inspection); default 2000
# SERVICE_EVERY_HOURS=2000

# Seconds per stored health point (default 60)
# HEALTH_INTERVAL=60
